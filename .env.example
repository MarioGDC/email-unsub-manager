# ============================================
# Email Unsubscribe Manager - Configuración
# ============================================

# Tu dirección de correo electrónico
IMAP_EMAIL=tu-email@outlook.com

# Tu contraseña o contraseña de aplicación (si tienes 2FA activado)
# Outlook: https://account.microsoft.com/security → Contraseñas de aplicación
# Gmail: https://myaccount.google.com/apppasswords
IMAP_PASSWORD=tu-contraseña-aquí

# Servidor IMAP (déjalo vacío para autodetección basada en tu email)
# Outlook/Hotmail/Live: outlook.office365.com
# Gmail: imap.gmail.com
# Yahoo: imap.mail.yahoo.com
IMAP_SERVER=
IMAP_PORT=993

# Número máximo de correos a escanear
MAX_EMAILS_TO_SCAN=500
