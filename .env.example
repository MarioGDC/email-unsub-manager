# ============================================
# Gmail Configuration
# ============================================
# Obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json

# ============================================
# Outlook / Microsoft Configuration
# ============================================
# Obtain these from Azure Portal:
# https://portal.azure.com/ -> App registrations
OUTLOOK_CLIENT_ID=your-client-id-here
OUTLOOK_CLIENT_SECRET=your-client-secret-here
OUTLOOK_TENANT_ID=your-tenant-id-here

# ============================================
# General Settings
# ============================================
# Maximum number of emails to scan
MAX_EMAILS_TO_SCAN=500
