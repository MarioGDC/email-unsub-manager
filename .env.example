# ============================================
# IMAP Universal (Recomendado - no requiere Azure ni Google Cloud)
# ============================================
# Tu dirección de correo electrónico
IMAP_EMAIL=tu-email@outlook.com
# Tu contraseña o contraseña de aplicación (si tienes 2FA activado)
IMAP_PASSWORD=tu-contraseña-aquí
# Servidor IMAP (déjalo vacío para autodetección basada en el email)
# Outlook/Hotmail: outlook.office365.com
# Gmail:          imap.gmail.com
# Yahoo:          imap.mail.yahoo.com
IMAP_SERVER=
IMAP_PORT=993

# ============================================
# Gmail Configuration
# ============================================
# Obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=credentials.json

# ============================================
# Outlook / Microsoft Configuration
# ============================================
# Obtain these from Azure Portal:
# https://portal.azure.com/ -> App registrations
OUTLOOK_CLIENT_ID=your-client-id-here
OUTLOOK_CLIENT_SECRET=your-client-secret-here
OUTLOOK_TENANT_ID=your-tenant-id-here

# ============================================
# General Settings
# ============================================
# Maximum number of emails to scan
MAX_EMAILS_TO_SCAN=500
